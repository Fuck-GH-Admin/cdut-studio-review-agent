  "rules": [
    {
      "id": "d2-b9d3b059588b8110e6dd",
      "policyVersionId": "workspace:d2-d310-agent-b-archive@3",
      "title": "档案复制独立授权（本地）",
      "requirement": "适用范围：同一申请内按档案件与操作分别核验\n按原始档案MD R23 逐档案件核复制操作范围。查阅授权不自动推出复制资格。馆方权限未核时不得判复制合格。\n完成标准：逐项给出复制范围、实际证据及待授权原因。\n责任边界：查阅、摘录、复制、外借不得相互继承授权\n不替代行政批准和档案馆出件。\nD2 技术预审来源：school-policy-unverified/policy-candidate/unknown\n行政边界：技术核验结果不能代替学校制度确认、授权或最终批准。\n校规/外校参考适用性未获确认：只能报告 awaiting-confirmation。",
      "when": {
        "all": []
      },
      "targetScope": "case",
      "execution": "semantic",
      "semanticOutputEnum": [
        "compliant",
        "non-compliant"
      ],
      "onFail": "manual-review",
      "onUnknown": "needs-confirmation",
      "sourceRefIds": [
        "school-policy-unverified"
      ],
      "priority": 50000,
      "confirmation": "unconfirmed"
    },
    {
      "id": "d2-3eb30a800377614dbb59",
      "policyVersionId": "workspace:d2-d310-agent-b-archive@3",
      "title": "开放状态",
      "requirement": "适用范围：当前申请中已明确指定的审核对象；审核对象：item-1\n目录可见不等于馆方确认档案已开放；缺少可信开放记录须待人工核验\n完成标准：记录独立局部状态、可追溯依据与未完成原因\n责任边界：材料预审不等于行政批准，不得对不相关对象复用资格结论\n查阅、摘录、复制、外借不得相互继承授权\n本责任不产生正式批准或拒批\nD2 技术预审来源：synthetic-source/synthetic/request-scope\n行政边界：技术核验结果不能代替学校制度确认、授权或最终批准。",
      "when": {
        "all": []
      },
      "sectionId": "d2-scope-6b9fab15cf3bab24",
      "targetScope": "subject",
      "execution": "semantic",
      "semanticOutputEnum": [
        "compliant",
        "non-compliant"
      ],
      "onFail": "manual-review",
      "onUnknown": "needs-confirmation",
      "sourceRefIds": [
        "synthetic-source"
      ],
      "priority": 50001,
      "confirmation": "confirmed"
    },
    {
      "id": "d2-2cf6d714fbe349fc29df",
      "policyVersionId": "workspace:d2-d310-agent-b-archive@3",
      "title": "当前动作授权",
      "requirement": "适用范围：当前申请中已明确指定的审核对象；审核对象：item-1/copy\n核对授权是否覆盖 复制 动作、对象和有效期限；其他操作授权不得移用\n完成标准：记录独立局部状态、可追溯依据与未完成原因\n责任边界：材料预审不等于行政批准，不得对不相关对象复用资格结论\n查阅、摘录、复制、外借不得相互继承授权\n本责任不产生正式批准或拒批\nD2 技术预审来源：school-policy-unverified/policy-candidate/unknown\n行政边界：技术核验结果不能代替学校制度确认、授权或最终批准。\n校规/外校参考适用性未获确认：只能报告 awaiting-confirmation。",
      "when": {
        "all": []
      },
      "sectionId": "d2-scope-ad0607d90809e3d2",
      "targetScope": "subject",
      "execution": "semantic",
      "semanticOutputEnum": [
        "compliant",
        "non-compliant"
      ],
      "onFail": "manual-review",
      "onUnknown": "needs-confirmation",
      "sourceRefIds": [
        "school-policy-unverified"
      ],
      "priority": 50002,
      "confirmation": "unconfirmed"
    },
    {
      "id": "d2-e8c768436e7d1f9bef8d",
      "policyVersionId": "workspace:d2-d310-agent-b-archive@3",
      "title": "事实与证据版本对应",
      "requirement": "适用范围：由模板明确指向的事实对象与操作；审核对象：item-1/read\n核对 档案 item-1 查阅对应事实 所依据的原件来源、对应当事人、有效时段与材料版本；若权威来源未知或只覆盖别的操作则报告待确认\n完成标准：逐项指出可引用的材料和版本及仍待补证事实；不得在没有真实 SourceRef 时声明符合\n责任边界：不将一份证明扩展到其他事项；不确认档案开放、校园卡资格或有权批准。\n查阅、摘录、复制、外借不得相互继承授权\n可定位事实不等于法律效力、行政批准或其他事实自动证成\nD2 技术预审来源：synthetic-source/synthetic/request-scope\n行政边界：技术核验结果不能代替学校制度确认、授权或最终批准。",
      "when": {
        "all": []
      },
      "sectionId": "d2-scope-9bc8b24cf4302321",
      "targetScope": "subject",
      "execution": "semantic",
      "semanticOutputEnum": [
        "compliant",
        "non-compliant"
      ],
      "onFail": "manual-review",
      "onUnknown": "needs-confirmation",
      "sourceRefIds": [
        "synthetic-source"
      ],
      "priority": 50003,
      "confirmation": "confirmed"
    },
    {
      "id": "d2-09b7948a3a74e27100ee",
      "policyVersionId": "workspace:d2-d310-agent-b-archive@3",
      "title": "当前动作授权",
      "requirement": "适用范围：当前申请中已明确指定的审核对象；审核对象：item-1/read\n核对授权是否覆盖 查阅 动作、对象和有效期限；其他操作授权不得移用\n完成标准：记录独立局部状态、可追溯依据与未完成原因\n责任边界：材料预审不等于行政批准，不得对不相关对象复用资格结论\n查阅、摘录、复制、外借不得相互继承授权\n本责任不产生正式批准或拒批\nD2 技术预审来源：school-policy-unverified/policy-candidate/unknown\n行政边界：技术核验结果不能代替学校制度确认、授权或最终批准。\n校规/外校参考适用性未获确认：只能报告 awaiting-confirmation。",
