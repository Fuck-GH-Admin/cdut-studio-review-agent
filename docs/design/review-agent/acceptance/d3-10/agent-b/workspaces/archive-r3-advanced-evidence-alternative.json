        "limits": "材料预审不等于行政批准，不得对不相关对象复用资格结论",
        "tasks": [
          {
            "id": "authorization",
            "title": "当前动作授权",
            "requirement": "核对授权是否覆盖 {{action}} 动作、对象和有效期限；其他操作授权不得移用",
            "completion": "记录独立局部状态、可追溯依据与未完成原因",
            "limits": "本责任不产生正式批准或拒批"
          },
          {
            "id": "scope-trace",
            "title": "局部证据范围追踪",
            "requirement": "记录{{action}}的被代理人、档案件或卡务事项、操作、授权期限；任一维度未知不得取其他操作授权补足。",
            "completion": "输出该操作的证据版本与授权有效期间，未知保持待核。",
            "limits": "不会推断档案开放、复制权限或发卡资格。"
          }
        ],
        "parameters": [
          {
            "key": "action",
            "description": "当前独立申请操作"
          }
        ]
