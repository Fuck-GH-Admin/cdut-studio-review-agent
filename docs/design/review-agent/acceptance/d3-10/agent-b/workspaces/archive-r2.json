  "definitions": {
    "modules": [
      {
        "moduleId": "archive-open-status",
        "version": 1,
        "name": "档案开放状态核验",
        "purpose": "区分档案目录可见与开放授权",
        "scope": "当前申请中已明确指定的审核对象",
        "source": {
          "kind": "synthetic",
          "note": "D0.5 合成案例，非成都理工大学或其他学校的现行规则"
        },
        "limits": "材料预审不等于行政批准，不得对不相关对象复用资格结论",
        "tasks": [
          {
            "id": "open-state",
            "title": "开放状态",
            "requirement": "目录可见不等于馆方确认档案已开放；缺少可信开放记录须待人工核验",
            "completion": "记录独立局部状态、可追溯依据与未完成原因",
            "limits": "本责任不产生正式批准或拒批"
          }
        ],
        "parameters": []
      },
      {
        "moduleId": "agent-authorization",
        "version": 1,
        "name": "代理权限范围核验",
        "purpose": "判断代理授权是否覆盖当事人及本次操作",
        "scope": "当前申请中已明确指定的审核对象",
        "source": {
          "kind": "synthetic",
          "note": "D0.5 合成案例，非成都理工大学或其他学校的现行规则"
        },
        "limits": "材料预审不等于行政批准，不得对不相关对象复用资格结论",
        "tasks": [
          {
            "id": "authorization",
            "title": "当前动作授权",
            "requirement": "核对授权是否覆盖 {{action}} 动作、对象和有效期限；其他操作授权不得移用",
            "completion": "记录独立局部状态、可追溯依据与未完成原因",
            "limits": "本责任不产生正式批准或拒批"
          }
        ],
        "parameters": [
          {
            "key": "action",
            "description": "当前独立申请操作"
          }
        ]
      },
      {
        "moduleId": "evidence-source-boundary",
        "version": 1,
        "name": "待证事实与原件来源覆盖（B02 合成候选）",
        "purpose": "针对一个指定待证事实报告可信材料出处、版本以及无法确认的情形；不推断业务资格",
        "scope": "由模板明确指向的事实对象与操作",
        "source": {
          "kind": "synthetic",
          "note": "D3 B02 合成候选，不是成都理工大学的正式校规"
        },
        "limits": "不将一份证明扩展到其他事项；不确认档案开放、校园卡资格或有权批准。",
        "parameters": [
          {
            "key": "matter",
            "description": "本次待证事实，不得扩大到其他对象"
          }
        ],
        "tasks": [
          {
            "id": "evidence-boundary",
            "title": "事实与证据版本对应",
            "requirement": "核对 {{matter}} 所依据的原件来源、对应当事人、有效时段与材料版本；若权威来源未知或只覆盖别的操作则报告待确认",
            "completion": "逐项指出可引用的材料和版本及仍待补证事实；不得在没有真实 SourceRef 时声明符合",
            "limits": "可定位事实不等于法律效力、行政批准或其他事实自动证成"
          }
        ]
      }
    ],
    "templates": [
      {
        "templateId": "archive-access",
        "version": 1,
        "name": "档案利用逐操作预审（合成）",
        "purpose": "同一申请内按档案件与操作分别核验",
        "limits": "查阅、摘录、复制、外借不得相互继承授权",
        "source": {
          "kind": "synthetic",
          "note": "D0.5 合成案例，非成都理工大学或其他学校的现行规则"
        },
        "modules": [
