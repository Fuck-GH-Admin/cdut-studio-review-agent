        "tasks": [
          {
            "id": "relation",
            "title": "关系证明",
            "requirement": "核对申请人、拟持卡人与关联教职工的关系；关联教职工已故时不可机械等同于无资格",
            "completion": "记录独立局部状态、可追溯依据与未完成原因",
            "limits": "本责任不产生正式批准或拒批"
          }
        ],
        "parameters": []
      },
