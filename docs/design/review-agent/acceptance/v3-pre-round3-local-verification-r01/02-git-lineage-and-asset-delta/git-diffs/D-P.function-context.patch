   ipcMain.handle(REVIEW_IPC_CHANNELS.EXTRACT_ITEMS, async (_event, caseId: string): Promise<ReviewItem[]> => {
     const items = await extractItems(caseId)
     await syncWorkspaceProjectionV2(caseId)
     return items
   })
 
