        "parseRevision": 1,
        "parseStatus": "parsed",
        "blocks": [
          {
            "blockId": "doc-1-muye1tz0-v1-block-001",
            "text": "# 校内文件/协议完整性核对 测试材料规则来源",
            "location": {
              "kind": "paragraph",
              "index": 0
            },
            "kind": "text"
          },
          {
            "blockId": "doc-1-muye1tz0-v1-block-002",
            "text": "**范围声明：**本文件用于隔离的合成流程测试，不是正式校规、申报通知、财务审批或法律意见。所有测试身份、编号和金额均虚构。",
            "location": {
              "kind": "paragraph",
              "index": 1
            },
            "kind": "text"
          },
          {
            "blockId": "doc-1-muye1tz0-v1-block-003",
            "text": "## 公开来源与适用边界",
            "location": {
              "kind": "paragraph",
              "index": 2
            },
            "kind": "text"
          },
          {
            "blockId": "doc-1-muye1tz0-v1-block-004",
            "text": "### 《中华人民共和国民法典》（最高人民检察院门户网全文）",
            "location": {
              "kind": "paragraph",
              "index": 3
            },
            "kind": "text"
          },
          {
            "blockId": "doc-1-muye1tz0-v1-block-005",
            "text": "- 来源：https://www.spp.gov.cn/spp/fl/202006/t20200602_463888.shtml",
            "location": {
              "kind": "paragraph",
              "index": 4
            },
            "kind": "text"
          },
          {
            "blockId": "doc-1-muye1tz0-v1-block-006",
            "text": "- 适用范围：公开法律文本中的合同形式、一般条款、合同书成立等条文；此测试不作法律意见或合同效力判断。",
            "location": {
              "kind": "paragraph",
              "index": 5
            },
            "kind": "text"
          },
          {
            "blockId": "doc-1-muye1tz0-v1-block-007",
            "text": "## 本次审核的规则边界",
            "location": {
              "kind": "paragraph",
              "index": 6
            },
            "kind": "text"
          },
          {
            "blockId": "doc-1-muye1tz0-v1-block-008",
            "text": "民法典条文仅用于合同形式及一般内容的核对提示；不得据此自动判断协议成立、生效、效力、违约责任或法律合规。",
            "location": {
              "kind": "paragraph",
              "index": 7
            },
            "kind": "text"
          },
          {
            "blockId": "doc-1-muye1tz0-v1-block-009",
            "text": "## 测试要求",
            "location": {
              "kind": "paragraph",
              "index": 8
            },
            "kind": "text"
          },
          {
            "blockId": "doc-1-muye1tz0-v1-block-010",
            "text": "- 只把来源文件中明确写出的内容当作外部规则。",
            "location": {
              "kind": "paragraph",
              "index": 9
            },
            "kind": "text"
          },
          {
            "blockId": "doc-1-muye1tz0-v1-block-011",
            "text": "- 缺少校内当年通知、审批、积分映射、授权签字或有效性确认时，标记待确认，不要猜测。",
            "location": {
              "kind": "paragraph",
              "index": 10
            },
            "kind": "text"
          },
          {
            "blockId": "doc-1-muye1tz0-v1-block-012",
            "text": "- 证据需要引用案卷中的具体材料与可定位位置。",
            "location": {
              "kind": "paragraph",
              "index": 11
            },
            "kind": "text"
          },
          {
            "blockId": "doc-1-muye1tz0-v1-block-013",
            "text": "- 本文件并非本次模拟数据的答案。",
            "location": {
              "kind": "paragraph",
              "index": 12
            },
            "kind": "text"
          }
        ],
        "usage": "registered",
        "byteHash": "2c3f875ba59ef8737a93dacca69c0cbe3f3fe7c28915bf9323d568e11ee1cfef",
